#!/bin/sh
# Sourced, not run, so these exports reach envsubst. The uid is read live.
export RUNTIME_UID="$(id -u)"

# envsubst needs a default, or nginx reads a leftover ${NAME} as its own.
export POD_NAME="${POD_NAME:-unknown}"
export POD_NAMESPACE="${POD_NAMESPACE:-unknown}"
export POD_IP="${POD_IP:-unknown}"
export NODE_NAME="${NODE_NAME:-unknown}"
export IMAGE_DIGEST="${IMAGE_DIGEST:-unknown}"
